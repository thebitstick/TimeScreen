    "Press %@, or hold ⌘⇧ and scroll, to open the timeline. You can also use the menu bar icon. Esc closes it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %@ oder halte ⌘⇧ gedrückt und scrolle, um die Zeitleiste zu öffnen. Du kannst auch das Symbol in der Menüleiste verwenden. Mit Esc schließt du sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@, o mantén ⌘⇧ y desplázate, para abrir la cronología. También puedes usar el icono de la barra de menús. Esc la cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@, ou maintenez ⌘⇧ et faites défiler, pour ouvrir la chronologie. Vous pouvez aussi utiliser l'icône de la barre des menus. Échap la ferme."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を押すか、⌘⇧を押したままスクロールすると、タイムラインが開きます。メニューバーのアイコンも使えます。Escで閉じます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Druk op %@, of houd ⌘⇧ ingedrukt en scrol, om de tijdlijn te openen. Je kunt ook het symbool in de menubalk gebruiken. Met Esc sluit je de tijdlijn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 %@，或按住 ⌘⇧ 并滑动，即可打开时间线。你也可以使用菜单栏图标。按 Esc 关闭。"
          }
        }
      }
    },
