    "Text recognition stopped working, so new screenshots can't be searched. Quit and reopen TimeScreen." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Texterkennung funktioniert nicht mehr, daher können neue Bildschirmfotos nicht durchsucht werden. Beende TimeScreen und öffne es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocimiento de texto dejó de funcionar, por lo que las nuevas capturas de pantalla no se pueden buscar. Cierra y vuelve a abrir TimeScreen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La reconnaissance de texte a cessé de fonctionner, les nouvelles captures d'écran ne peuvent donc pas être recherchées. Quittez puis rouvrez TimeScreen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト認識が停止したため、新しいスクリーンショットを検索できません。TimeScreenを終了して、もう一度開いてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstherkenning werkt niet meer, waardoor nieuwe schermafbeeldingen niet doorzoekbaar zijn. Stop TimeScreen en open het opnieuw."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文本识别已停止工作，因此无法搜索新的截屏。请退出并重新打开 TimeScreen。"
          }
        }
      }
    },
