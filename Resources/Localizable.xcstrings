    "Star a screenshot (S) to keep it forever.\nStarred ones are never deleted by retention or the size limit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiere ein Bildschirmfoto (S), um es für immer zu behalten.\nMarkierte werden weder durch die Aufbewahrungsdauer noch durch das Größenlimit gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaca una captura de pantalla (S) para conservarla para siempre.\nLas destacadas nunca se eliminan por la retención ni por el límite de tamaño."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez une capture d'écran (S) pour la conserver pour toujours.\nLes captures marquées ne sont jamais supprimées par la conservation ni par la limite de taille."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スクリーンショットにスター (S) を付けると、ずっと保存されます。\nスター付きのものは、保存期間やサイズ制限では削除されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer een schermafbeelding (S) om die voor altijd te bewaren.\nGemarkeerde afbeeldingen worden nooit verwijderd door de bewaartermijn of de groottelimiet."
          }
        },
        "zh-Hans" : {
