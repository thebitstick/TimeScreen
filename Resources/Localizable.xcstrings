    "Stars the newest screenshot from any app so it is kept forever. Plays a chime. Not set by default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert das neueste Bildschirmfoto aus jeder App, damit es für immer behalten wird. Spielt einen Signalton ab. Standardmäßig nicht festgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Destaca la captura de pantalla más reciente desde cualquier app para conservarla para siempre. Reproduce un sonido. No está definido de forma predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque la capture d'écran la plus récente depuis n'importe quelle app pour la conserver pour toujours. Émet un carillon. Non défini par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのAppからでも最新のスクリーンショットにスターを付け、ずっと保存します。チャイムが鳴ります。初期設定では未設定です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeert de nieuwste schermafbeelding vanuit elke app zodat die voor altijd bewaard blijft. Speelt een geluidje af. Standaard niet ingesteld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在任何 App 中为最新截屏加星标，使其永久保留。会播放提示音。默认未设置。"
          }
        }
      }
    },
