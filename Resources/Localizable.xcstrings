    "Turn off to capture only the main display. The timeline has a picker when you have more than one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte es aus, um nur den Hauptbildschirm aufzunehmen. Die Zeitleiste hat eine Auswahl, wenn du mehrere Bildschirme hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desactívalo para capturar solo la pantalla principal. La cronología incluye un selector cuando tienes más de una."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivez pour ne capturer que l'écran principal. La chronologie propose un sélecteur quand vous en avez plusieurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、メインディスプレイだけをキャプチャします。複数のディスプレイがある場合、タイムラインに切り替えメニューが表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet uit om alleen het hoofdscherm vast te leggen. De tijdlijn heeft een keuzemenu als je er meer dan één hebt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭后只截取主显示器。有多台显示器时，时间线中会显示选择器。"
          }
        }
      }
    },
    "Turn on Apple Intelligence in System Settings to write summaries." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Apple Intelligence in den Systemeinstellungen, um Zusammenfassungen zu schreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Apple Intelligence en Ajustes del Sistema para escribir resúmenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Apple Intelligence dans Réglages Système pour rédiger des résumés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約を作成するには、「システム設定」でApple Intelligenceをオンにしてください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Apple Intelligence aan in Systeeminstellingen om samenvattingen te schrijven."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置”中开启 Apple Intelligence 以生成摘要。"
          }
        }
      }
    },
    "Turn on the timeline lock" : {
