    },
    "Written on this Mac by on-device Apple Intelligence from the text it read on your screen. Summaries can be wrong, so check the screenshot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf diesem Mac von Apple Intelligence auf dem Gerät aus dem Text geschrieben, den es auf deinem Bildschirm gelesen hat. Zusammenfassungen können falsch sein, prüfe also das Bildschirmfoto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrito en este Mac por Apple Intelligence en el dispositivo a partir del texto que leyó en tu pantalla. Los resúmenes pueden contener errores, así que revisa la captura de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rédigé sur ce Mac par Apple Intelligence sur l'appareil à partir du texte lu sur votre écran. Les résumés peuvent être erronés : vérifiez la capture d'écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面から読み取ったテキストをもとに、オンデバイスのApple IntelligenceがこのMac上で作成しました。要約には誤りがある場合があるため、スクリーンショットで確認してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Op deze Mac geschreven door Apple Intelligence op het apparaat, op basis van de tekst die het op je scherm las. Samenvattingen kunnen fout zijn, dus controleer de schermafbeelding."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由设备端 Apple Intelligence 根据在屏幕上读取的文本在这台 Mac 上生成。摘要可能有误，请核对截屏。"
          }
        }
      }
    },
