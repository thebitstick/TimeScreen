    "Pauses or resumes recording from any app, with a short sound so you know which. Not set by default." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert oder setzt die Aufnahme aus jeder App heraus fort, mit einem kurzen Ton, damit du weißt, was passiert ist. Standardmäßig nicht festgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa o reanuda la grabación desde cualquier app, con un sonido breve para saber cuál de las dos acciones se realizó. No está definido de forma predeterminada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspend ou reprend l'enregistrement depuis n'importe quelle app, avec un bref son pour savoir lequel des deux. Non défini par défaut."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのAppからでも録画を一時停止または再開します。どちらになったか分かるよう、短い音が鳴ります。初期設定では未設定です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderbreekt of hervat de opname vanuit elke app, met een kort geluid zodat je weet welke van de twee. Standaard niet ingesteld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在任何 App 中暂停或继续录制，并播放短提示音以便区分。默认未设置。"
          }
        }
      }
    },
