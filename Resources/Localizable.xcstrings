    "Hold both keys and scroll with two fingers. Keep scrolling to scrub through time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte beide Tasten gedrückt und scrolle mit zwei Fingern. Scrolle weiter, um durch die Zeit zu navigieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsadas ambas teclas y desplázate con dos dedos. Sigue desplazándote para recorrer el tiempo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez les deux touches et faites défiler avec deux doigts. Continuez à faire défiler pour parcourir le temps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方のキーを押したまま、2本指でスクロールします。そのままスクロールすると、時間をさかのぼれます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd beide toetsen ingedrukt en scrol met twee vingers. Blijf scrollen om door de tijd te bladeren."
