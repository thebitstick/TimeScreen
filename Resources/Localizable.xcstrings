    "A searchable history of your screen. It all stays on this Mac, and nothing is sent anywhere." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein durchsuchbarer Verlauf deines Bildschirms. Alles bleibt auf diesem Mac, nichts wird irgendwohin gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un historial de tu pantalla en el que se puede buscar. Todo se queda en este Mac y no se envía nada a ningún sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un historique de votre écran, avec recherche. Tout reste sur ce Mac et rien n'est envoyé ailleurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検索できる画面の履歴。すべてこのMac上に保存され、外部には何も送信されません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een doorzoekbare geschiedenis van je scherm. Alles blijft op deze Mac en er wordt niets verstuurd."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可搜索的屏幕历史记录。所有内容都保留在这台 Mac 上，不会发送到任何地方。"
          }
        }
      }
    },
    "A window is treated as private when its title contains one of these words, one per line. Browsers word this differently, so add your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fenster gilt als privat, wenn sein Titel eines dieser Wörter enthält, eines pro Zeile. Browser formulieren das unterschiedlich, füge also eigene hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una ventana se considera privada cuando su título contiene una de estas palabras, una por línea. Cada navegador lo expresa de forma distinta, así que añade las tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fenêtre est considérée comme privée quand son titre contient l'un de ces mots, un par ligne. Chaque navigateur le formule différemment : ajoutez les vôtres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウのタイトルにこれらの語（1行に1つ）のいずれかが含まれている場合、そのウインドウはプライベートと見なされます。ブラウザによって表記が異なるため、必要に応じて追加してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een venster wordt als privé beschouwd als de titel een van deze woorden bevat, één per regel. Browsers noemen dit verschillend, dus voeg gerust je eigen woorden toe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窗口标题包含以下任一词语（每行一个）时，该窗口会被视为隐私窗口。不同浏览器的叫法不同，因此可以添加你自己的词语。"
          }
        }
      }
    },
